    "inquirer": "^12.6.3",
    "jsonrepair": "^3.15.0",
    "next": "^16.1.0",
    "openai": "^4.103.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
