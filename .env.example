# 本地开发和生产部署统一使用服务端环境变量。
# Netlify 请在 Site configuration > Environment variables 中配置。
DEEPSEEK_API_KEY=你的DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 当前 Web 端固定使用 deepseek-v4-flash；保留该变量供 CLI 读取。
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：自定义片策项目输出目录。优先级低于 .piance/workspace.json
PIANCE_OUTPUT_DIR=output

# 可选：OpenAI-compatible 图片生成接口
IMAGE_API_KEY=你的图片生成_API_Key
IMAGE_API_URL=https://api.example.com/v1/images/generations
IMAGE_MODEL=你的图片生成模型名
# 常见接口使用 size；部分接口使用 aspect_ratio
IMAGE_API_SIZE_FIELD=size
# 可选：供应商特有参数，必须是单行 JSON 对象
IMAGE_API_EXTRA_BODY={}
