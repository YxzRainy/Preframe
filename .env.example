# 片策只在本机运行。复制为 .env 后填写自己的密钥；.env 已被 Git 忽略。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 当前 Web 端固定使用 deepseek-v4-flash；该变量供 CLI 读取。
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选：自定义本机项目输出目录。优先级低于 .piance/workspace.json
PIANCE_OUTPUT_DIR=

# 可选：OpenAI-compatible 图片生成接口。提示词会发送到该接口，生成图片保存到本机。
IMAGE_API_KEY=
IMAGE_API_URL=https://api.example.com/v1/images/generations
IMAGE_MODEL=
# 常见接口使用 size；部分接口使用 aspect_ratio
IMAGE_API_SIZE_FIELD=size
# 可选：供应商特有参数，必须是单行 JSON 对象
IMAGE_API_EXTRA_BODY={}
